# Vorlage fuer die Zugangsdaten des taeglichen Berichts.
#
# Die echte Datei gehoert NICHT ins Repo, sondern nach
#   /home/deploy/KITech/infra/secrets/tagesbericht.env
# mit `chmod 600` — sie enthaelt ein Azure-Client-Secret.

# --- Plausible (self-hosted) -----------------------------------------------
# Schluessel aus stats.kitech-software.de → Settings → API Keys.
PLAUSIBLE_API_KEY=
PLAUSIBLE_API_URL=https://stats.kitech-software.de
PLAUSIBLE_SITE_ID=kitech-software.de

# --- Microsoft 365 / Graph (Client Credentials) ----------------------------
# Dieselbe App-Registrierung wie im Outreach. Sie braucht die
# *Application*-Rolle `Mail.Send` mit Admin-Consent — ohne die antwortet Graph
# mit 403, und der Bericht bleibt liegen.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Wer schreibt an wen ---------------------------------------------------
# MAIL_VON muss ein echtes Postfach im Tenant sein — Graph verschickt aus ihm.
MAIL_VON=
MAIL_VON_NAME=KITech Website
MAIL_AN=aalkh@kitech-software.de
