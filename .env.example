# Alle clientseitig benoetigten Variablen brauchen in Next.js das Praefix
# NEXT_PUBLIC_ (frueher VITE_). Ohne das Praefix sind sie nur serverseitig sichtbar.

# Kontaktformular Webhook (n8n oder anderer Service)
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact-form

# Basis-URL des eingeloggten Bereichs. Die Marketing-Seiten verlinken damit auf
# den Anmelden-Button. Lokal ohne DNS-Eintrag: http://localhost:8081/app
NEXT_PUBLIC_APP_URL=https://app.kitech-software.de

# Supabase (aktuell noch ungenutzt - vorbereitet fuer das Learning-Portal)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Plausible ist bewusst hardcoded in src/lib/plausible.ts und CookieConsent.tsx.

# ---------------------------------------------------------------------------
# LogTo — Auth fuer den eingeloggten Bereich (app.kitech-software.de).
#
# ALLE Variablen hier sind bewusst OHNE NEXT_PUBLIC_-Praefix: mit Praefix wuerde
# Next.js sie in das Client-Bundle inlinen, und LOGTO_APP_SECRET bzw.
# LOGTO_COOKIE_SECRET waeren im Quelltext jeder ausgelieferten Seite lesbar.
# ---------------------------------------------------------------------------

# LogTo Core-Endpoint (OIDC-Discovery), z. B. https://auth.kitech-software.de
LOGTO_ENDPOINT=

# OIDC-Application vom Typ "Traditional Web App" aus der LogTo Admin Console.
LOGTO_APP_ID=
LOGTO_APP_SECRET=

# Oeffentliche Basis-URL des App-Bereichs, ohne trailing slash.
# Produktion: https://app.kitech-software.de   Lokal: http://localhost:8081
# Steuert zusaetzlich cookieSecure (siehe src/lib/auth/logto.ts) — deshalb muss
# das Schema stimmen. In der LogTo Admin Console zu hinterlegen:
#   Redirect URI          <LOGTO_BASE_URL>/auth/callback
#   Post sign-out URI     https://kitech-software.de
LOGTO_BASE_URL=

# Schluessel zur Verschluesselung der Session-Cookies, mind. 32 Zeichen.
# Generieren mit: openssl rand -base64 32
LOGTO_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Besuchsmeldung der Kampagnenseiten (/funnel, /fokus)
#
# Jeder Aufruf wird an diese Adresse gemeldet — unabhaengig vom Cookie-Banner,
# ohne Cookie und ohne IP-Weitergabe (Begruendung in
# src/app/api/funnel-besuch/route.ts). Ohne die Variable passiert nichts; die
# Seiten funktionieren unveraendert.
#
# Bewusst OHNE NEXT_PUBLIC_-Praefix: mit Praefix stuenden Adresse und Secret im
# Client-Bundle und waeren im Quelltext jeder Seite lesbar.
#
# Runtime-Variable — in Coolify setzen und neu starten, kein Rebuild noetig.
# ---------------------------------------------------------------------------

# Wohin die Meldung geht, z. B. ein n8n-Webhook, der eine Nachricht verschickt.
FUNNEL_BESUCH_WEBHOOK_URL=

# Optional: wird als Header `x-tracking-secret` mitgeschickt, damit der
# Empfaenger fremde Aufrufe abweisen kann.
FUNNEL_BESUCH_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sofortmeldung wichtiger Ereignisse (14.08.2026)
#
# Terminseite geoeffnet, Popup-Knopf geklickt, Telefon/E-Mail angeklickt,
# Selbstcheck abgeschlossen, Besuch (einmal je Sitzung, nur mit Einwilligung).
# Begruendung und Datenumfang: src/app/api/ereignis/route.ts.
#
# Ohne EREIGNIS_WEBHOOK_URL passiert nichts — die Route bestaetigt still.
# Alle drei sind Runtime-Variablen: in Coolify setzen, neu starten, kein
# Rebuild noetig. Kein NEXT_PUBLIC_-Praefix, sie bleiben serverseitig.
# ---------------------------------------------------------------------------

# Wohin die Meldung geht, z. B. ein n8n-Webhook, der eine Nachricht verschickt.
EREIGNIS_WEBHOOK_URL=

# Optional: Header `x-tracking-secret` fuer den Empfaenger.
EREIGNIS_WEBHOOK_SECRET=

# Optional: Token fuer ipinfo.io. Nur damit wird die Firma hinter der IP
# ermittelt — und nur bei Besuchern, die dem Cookie-Banner zugestimmt haben.
# Ohne Token unterbleibt die Abfrage vollstaendig.
#
# ⚠️ Der Cookie-Banner und /datenschutz kuendigen die Firmenerkennung an. Wer
# sie dauerhaft nicht will, nimmt dort die Textstellen mit heraus.
IPINFO_TOKEN=

# ---------------------------------------------------------------------------
# Tagesbericht aus Plausible (14.08.2026)
#
# POST /api/tagesbericht mit Header `x-tagesbericht-secret` liefert die Zahlen
# des Vortags und schickt sie an den Webhook. Ausgeloest wird das von aussen
# (n8n, Coolify Scheduled Task, Cron) — die Seite hat keinen eigenen Zeitgeber.
# Ohne PLAUSIBLE_API_KEY oder TAGESBERICHT_SECRET antwortet die Route mit 404.
# ---------------------------------------------------------------------------

# Stats-API-Schluessel, in Plausible unter "Settings -> API Keys" erzeugen.
PLAUSIBLE_API_KEY=

# Frei gewaehltes Geheimnis, das der Cron mitschickt.
# Generieren mit: openssl rand -hex 32
TAGESBERICHT_SECRET=

# Optional, falls abweichend von https://stats.kitech-software.de bzw.
# kitech-software.de:
PLAUSIBLE_API_URL=
PLAUSIBLE_SITE_ID=

# Optional: eigener Empfaenger fuer den Tagesbericht. Ohne ihn geht er an
# EREIGNIS_WEBHOOK_URL.
TAGESBERICHT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# DataForSEO — Keyword-, SERP- und Backlink-Daten der Blog-Engine
#
# Client: scripts/blog-engine/lib/dataforseo.ts. Reine Build-/Skript-Zeit, kein
# NEXT_PUBLIC_-Praefix: die Daten werden beim Recherchelauf geholt, nicht im
# Browser. Mit Praefix stuenden die Zugangsdaten im Client-Bundle.
#
# ⚠️ Diese API kostet pro Aufruf Geld, ohne Freikontingent und ohne Warnung.
# Zum Entwickeln DATAFORSEO_SANDBOX=1 setzen.
# ---------------------------------------------------------------------------

# ⓘ Seit dem 23.08.2026 liest die Blog-Engine diese Datei tatsaechlich:
#   scripts/blog-engine/lib/umgebung.ts ruft process.loadEnvFile() auf und wird
#   von jedem Einstiegspunkt als erster Import geladen. Vorher stand hier eine
#   Vorlage fuer Variablen, die kein Skript je gesehen hat.
#
# API-Login und API-Passwort aus dem DataForSEO-Dashboard unter "API Access" —
# NICHT die Anmeldedaten des Benutzerkontos.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 1 = Sandbox (sandbox.dataforseo.com): kostenlos, Dummy-Daten, identische
# Antwortstruktur. Leer oder 0 = Produktion, es wird abgerechnet.
DATAFORSEO_SANDBOX=

# Harte Kostenbremse pro Prozesslauf in USD, Standard 5.00. Ist der Betrag
# verbraucht, bricht die naechste Anfrage ab, statt weiter abzubuchen.
# Der Zaehler lebt im Prozess — ein echtes Tageslimit zusaetzlich im
# DataForSEO-Dashboard setzen (die API quittiert es mit 40203).
DATAFORSEO_TAGESLIMIT_USD=5.00

# ---------------------------------------------------------------------------
# Firecrawl — liest die rankenden Seiten fuer die Recherche
#
# Client: scripts/blog-engine/lib/firecrawl.ts. Wie DataForSEO reine Skriptzeit,
# kein NEXT_PUBLIC_-Praefix.
# ---------------------------------------------------------------------------

# API-Schluessel aus dem Firecrawl-Dashboard, beginnt mit fc-.
FIRECRAWL_API_KEY=

# Harte Bremse pro Prozesslauf, Standard 300 Credits. Ein Seitenabruf kostet 1,
# eine Suche 2 je 10 Ergebnisse, strukturiertes Auslesen 5.
FIRECRAWL_TAGESLIMIT_CREDITS=300

# Optional, nur beim Selbsthosten von Firecrawl.
FIRECRAWL_API_URL=

# ---------------------------------------------------------------------------
# Anthropic — schreibt und prueft die Artikel
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# Harte Bremse pro Prozesslauf. Ein Artikel verbraucht ueberschlaegig 60.000 bis
# 120.000 Token ueber alle Schritte.
ANTHROPIC_TAGESLIMIT_TOKEN=2000000

# ---------------------------------------------------------------------------
# Blog-Automatik: Ablauf, Freigabe, Auslieferung
#
# Vollstaendige Anleitung: deploy/BLOG-ENGINE.md
# ---------------------------------------------------------------------------

# Wer als Freigebender in den Artikeln steht, wenn im Auto-Modus veroeffentlicht
# wird. Ohne Angabe steht dort "Automatik" — was ehrlich ist, aber schlechter.
BLOG_ENGINE_FREIGABE_VON=

# ⚠️ NUR mit 1 wird nach dem Commit auch deployt. Ohne die Variable endet der
# Lauf beim Push. Das Repo deployt bewusst nicht automatisch nach jedem Push
# (siehe CLAUDE.md, Abschnitt Hosting) — diese Variable ist die bewusste
# Ausnahme davon, und sie gehoert erst gesetzt, wenn ein paar Laeufe von Hand
# durchgesehen wurden.
BLOG_ENGINE_DEPLOY=

# Coolify-Deploy nach dem Push. Werte stehen in
# /home/deploy/KITech/infra/secrets/coolify-api-token.env.
COOLIFY_API_BASE=
COOLIFY_API_TOKEN=
COOLIFY_APP_UUID=j9vencbq8b2nugo86eimxnku

# Meldung nach jedem Lauf, z. B. an denselben n8n-Dienst wie die
# Ereignismeldung. Ohne die Variable passiert nichts.
BLOG_ENGINE_WEBHOOK_URL=
BLOG_ENGINE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# IndexNow — meldet neue Adressen an Bing, Yandex, Seznam, Naver, Yep,
# Internet Archive und Amazonbot.
#
# ⚠️ Google nimmt NICHT teil und war nie dabei. Der Nutzen liegt bei Bing und
# damit bei Microsoft Copilot — und bei den KI-Systemen, die ueber Amazonbot und
# das Internet Archive mitlesen.
#
# Schluessel: 8 bis 128 Zeichen, nur a-z, A-Z, 0-9 und Bindestrich. Erzeugen mit
#   openssl rand -hex 16
# Danach muss die Datei public/<key>.txt mit dem Schluessel als Inhalt
# existieren — scripts/blog-engine/lib/indexnow.ts legt sie an.
# ---------------------------------------------------------------------------

INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# n8n — nur zum Nachsehen und Steuern von der Kommandozeile.
#
# ⚠️ Die Anwendung liest diese beiden NICHT. Sie gehoeren nicht nach Coolify.
# Was die Website braucht, ist allein EREIGNIS_WEBHOOK_URL (weiter oben).
#
# Wozu: der Meldeweg ist zweimal lautlos ausgefallen — Status "success", keine
# Mail, in der Oberflaeche nichts Auffaelliges. Mit diesen beiden laesst sich
# von aussen nachlesen, was ein Lauf tatsaechlich entschieden hat:
#
#   curl -s -H "X-N8N-API-KEY: $N8N_API_KEY" \
#     "$N8N_BASIS_URL/api/v1/executions?workflowId=<id>&includeData=true"
#
# Schluessel erzeugen: n8n -> Settings -> n8n API -> Create an API key.
# Er laeuft ab; das Ablaufdatum steckt im Token selbst (Feld "exp").
# ---------------------------------------------------------------------------
N8N_BASIS_URL=https://<n8n-adresse>
N8N_API_KEY=
